{
  "type": "record",
  "name": "Task",
  "namespace": "axt.example.v1",
  "doc": "A task: something the user wants to do, possibly by a due date, possibly repeating.",
  "axt.version": 1,
  "axt.title": "title",
  "fields": [
    {
      "name": "title",
      "type": "string",
      "default": "",
      "doc": "What is to be done, as plain text on one line."
    },
    {
      "name": "notes",
      "type": "string",
      "default": "",
      "doc": "Free notes on the task, as plain text; lines are separated by LF. Empty when there are none."
    },
    {
      "name": "due",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "local-timestamp-millis"
        }
      ],
      "default": null,
      "doc": "The day, and the time on the wall clock, by which the task is due; see due_all_day and time_zone. Null when the task has no due date."
    },
    {
      "name": "due_all_day",
      "type": "boolean",
      "default": false,
      "doc": "True when the task is due on the day of due without a time of day; the time of due is then 00:00 and has no meaning."
    },
    {
      "name": "time_zone",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "The IANA time zone name, such as Europe/Berlin, in which due and the occurrences of repeat read on the wall clock. Null when due and the occurrences of repeat are meant in whatever time zone the user is in at that moment."
    },
    {
      "name": "repeat",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "How the task repeats: the value of an RFC 5545 RRULE property without the RRULE: prefix, such as FREQ=WEEKLY;BYDAY=TU. The occurrences start at due. Null when the task does not repeat."
    },
    {
      "name": "done",
      "type": "boolean",
      "default": false,
      "doc": "True when the task is done. For a repeating task: the occurrence at due is done."
    },
    {
      "name": "done_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "When the task was marked done. Null when it is not done or the time is not known."
    },
    {
      "name": "priority",
      "type": {
        "type": "enum",
        "name": "TaskPriority",
        "doc": "How important a task is. NONE: no priority given. LOW, MEDIUM, HIGH: low, medium and high priority. A symbol this version does not know is read as NONE.",
        "symbols": [
          "NONE",
          "LOW",
          "MEDIUM",
          "HIGH"
        ],
        "default": "NONE"
      },
      "default": "NONE",
      "doc": "How important the task is."
    }
  ]
}
