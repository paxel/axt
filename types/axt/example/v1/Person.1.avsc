{
  "type": "record",
  "name": "Person",
  "namespace": "axt.example.v1",
  "doc": "A person: a contact with name, birthday, phone numbers, email addresses and postal addresses.",
  "axt.version": 1,
  "fields": [
    {
      "name": "display_name",
      "type": "string",
      "default": "",
      "doc": "The name to show for the person, as the user wrote it, such as Dr. Anna Maria Schmidt. When empty, a receiver may build a name from the name parts."
    },
    {
      "name": "prefix",
      "type": "string",
      "default": "",
      "doc": "Titles written before the name, such as Dr. Empty when there are none."
    },
    {
      "name": "given_name",
      "type": "string",
      "default": "",
      "doc": "The given name, such as Anna. Empty when not known."
    },
    {
      "name": "middle_name",
      "type": "string",
      "default": "",
      "doc": "Further given names, such as Maria. Empty when there are none."
    },
    {
      "name": "family_name",
      "type": "string",
      "default": "",
      "doc": "The family name, such as Schmidt. Empty when not known."
    },
    {
      "name": "suffix",
      "type": "string",
      "default": "",
      "doc": "Additions written after the name, such as Jr. Empty when there are none."
    },
    {
      "name": "birthday",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Date",
          "namespace": "axt",
          "doc": "A calendar date of the proleptic Gregorian calendar, of which a part may be unknown, such as a birthday without a year (null, 5, 3), a year alone (2019, null, null) or a month of a year (2027, 3, null). At least one part is not null, and a day has its month. Defined in spec/time.md. Its schema never changes.",
          "fields": [
            {
              "name": "year",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "The year, 1 to 9999. Null when the year is not known or does not matter."
            },
            {
              "name": "month",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "The month of the year, 1 (January) to 12 (December). Null when the month is not known; then day is null as well."
            },
            {
              "name": "day",
              "type": [
                "null",
                "int"
              ],
              "default": null,
              "doc": "The day of the month, 1 to the number of days of the month: of that year when the year is known, otherwise of a leap year, so that 29 February is valid without a year. Null when the day is not known."
            }
          ]
        }
      ],
      "default": null,
      "doc": "The day of birth, as far as it is known: its year is null when only the day and the month are known, as address books often hold birthdays. Null when not known."
    },
    {
      "name": "phones",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "PersonPhone",
          "doc": "A phone number of a person.",
          "fields": [
            {
              "name": "label",
              "type": "string",
              "default": "",
              "doc": "What it is for, as the user wrote it, such as home, work or mobile. Empty when not given."
            },
            {
              "name": "number",
              "type": "string",
              "default": "",
              "doc": "The phone number in the international format of ITU-T E.164: a + and 2 to 15 digits, without spaces, such as +49301234567. Empty when not given."
            }
          ]
        }
      },
      "default": [],
      "doc": "The person's phone numbers, in the user's order. Empty when there are none."
    },
    {
      "name": "emails",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "PersonEmail",
          "doc": "An email address of a person.",
          "fields": [
            {
              "name": "label",
              "type": "string",
              "default": "",
              "doc": "What it is for, as the user wrote it, such as home or work. Empty when not given."
            },
            {
              "name": "address",
              "type": "string",
              "default": "",
              "doc": "The email address, such as anna@example.org. Empty when not given."
            }
          ]
        }
      },
      "default": [],
      "doc": "The person's email addresses, in the user's order. Empty when there are none."
    },
    {
      "name": "addresses",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "PersonAddress",
          "doc": "A postal address of a person. Every part is empty when not given.",
          "fields": [
            {
              "name": "label",
              "type": "string",
              "default": "",
              "doc": "What it is for, as the user wrote it, such as home or work. Empty when not given."
            },
            {
              "name": "street",
              "type": "string",
              "default": "",
              "doc": "The street and house number, and further lines such as a flat or a c/o, separated by LF."
            },
            {
              "name": "postal_code",
              "type": "string",
              "default": "",
              "doc": "The postal code, such as 10115."
            },
            {
              "name": "locality",
              "type": "string",
              "default": "",
              "doc": "The city, town or village."
            },
            {
              "name": "region",
              "type": "string",
              "default": "",
              "doc": "The state, province or county, where an address names one."
            },
            {
              "name": "country",
              "type": "string",
              "default": "",
              "doc": "The country, as an upper-case code of ISO 3166-1 alpha-2, such as DE."
            }
          ]
        }
      },
      "default": [],
      "doc": "The person's postal addresses, in the user's order. Empty when there are none."
    },
    {
      "name": "notes",
      "type": "string",
      "default": "",
      "doc": "Free notes on the person, as plain text; lines are separated by LF. Empty when there are none."
    },
    {
      "name": "relations",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "Relation",
          "namespace": "axt",
          "doc": "A relation: a link from the record that holds it to another record or to a thing outside AXT, of a kind, with information about the link. Defined in spec/fields.md, section 11.",
          "axt.label": "Relation",
          "axt.label_translations": {
            "de": "Verknüpfung"
          },
          "axt.help": "A link to another entry or to something outside, such as the pet an appointment is for.",
          "axt.help_translations": {
            "de": "Eine Verknüpfung mit einem anderen Eintrag oder mit etwas außerhalb, etwa mit dem Tier, für das ein Termin ist."
          },
          "axt.emoji": "🔗",
          "fields": [
            {
              "name": "id",
              "type": {
                "type": "string",
                "logicalType": "uuid"
              },
              "doc": "The id of the relation, a UUID in lower-case hexadecimal, unique among the relations of the record that holds it and kept for as long as the relation exists.",
              "axt.label": "Relation id",
              "axt.label_translations": {
                "de": "Verknüpfungs-ID"
              },
              "axt.help": "The id of this relation.",
              "axt.help_translations": {
                "de": "Die ID dieser Verknüpfung."
              },
              "axt.emoji": "🆔",
              "axt.advanced": true
            },
            {
              "name": "kind",
              "type": "string",
              "default": "axt.related",
              "doc": "The kind of the relation, a name in a namespace, written like the full name of a type, such as org.example.catalog.patient. axt.related, the only kind AXT defines, says only that the two are related. A receiver shows a kind it does not know as a relation of that name.",
              "axt.label": "Kind",
              "axt.label_translations": {
                "de": "Art"
              },
              "axt.help": "What kind of link this is.",
              "axt.help_translations": {
                "de": "Welche Art von Verknüpfung das ist."
              },
              "axt.emoji": "🔖"
            },
            {
              "name": "target",
              "type": [
                {
                  "type": "record",
                  "name": "RelationRecordTarget",
                  "doc": "A record as the target of a relation: by its id and its sender.",
                  "axt.label": "Entry",
                  "axt.label_translations": {
                    "de": "Eintrag"
                  },
                  "axt.help": "An entry of this app or of another.",
                  "axt.help_translations": {
                    "de": "Ein Eintrag dieser App oder einer anderen."
                  },
                  "axt.emoji": "📄",
                  "fields": [
                    {
                      "name": "id",
                      "type": {
                        "type": "string",
                        "logicalType": "uuid"
                      },
                      "doc": "The id of the target record.",
                      "axt.label": "Entry id",
                      "axt.label_translations": {
                        "de": "Eintrags-ID"
                      },
                      "axt.help": "The id of the linked entry.",
                      "axt.help_translations": {
                        "de": "Die ID des verknüpften Eintrags."
                      },
                      "axt.emoji": "🆔",
                      "axt.advanced": true
                    },
                    {
                      "name": "sender",
                      "type": [
                        "null",
                        {
                          "type": "fixed",
                          "name": "RelationRecordTargetSender",
                          "size": 32,
                          "doc": "An Ed25519 public key in the encoding of RFC 8032. Defined in spec/keys.md."
                        }
                      ],
                      "default": null,
                      "doc": "A key of the device set of the target record's sender. Null when the target is a record of the sender of the record that holds the relation.",
                      "axt.label": "Sender",
                      "axt.label_translations": {
                        "de": "Absender"
                      },
                      "axt.help": "The app the linked entry comes from.",
                      "axt.help_translations": {
                        "de": "Die App, von der der verknüpfte Eintrag kommt."
                      },
                      "axt.emoji": "🔑",
                      "axt.advanced": true
                    },
                    {
                      "name": "type",
                      "type": "string",
                      "default": "",
                      "doc": "The full name of the target record's type, which holds its major version, such as axt.example.v1.Pet. Empty when not known.",
                      "axt.label": "Type",
                      "axt.label_translations": {
                        "de": "Typ"
                      },
                      "axt.help": "The type of the linked entry.",
                      "axt.help_translations": {
                        "de": "Der Typ des verknüpften Eintrags."
                      },
                      "axt.emoji": "🧩",
                      "axt.advanced": true
                    },
                    {
                      "name": "text",
                      "type": "string",
                      "default": "",
                      "doc": "A text to show for the target while the record itself is not at hand, such as its title. Empty when there is none.",
                      "axt.label": "Display text",
                      "axt.label_translations": {
                        "de": "Anzeigetext"
                      },
                      "axt.help": "What to show for the linked entry.",
                      "axt.help_translations": {
                        "de": "Was für den verknüpften Eintrag angezeigt wird."
                      },
                      "axt.emoji": "💬"
                    }
                  ]
                },
                {
                  "type": "record",
                  "name": "RelationOutsideTarget",
                  "doc": "A thing outside AXT as the target of a relation: by a URI.",
                  "axt.label": "Outside thing",
                  "axt.label_translations": {
                    "de": "Etwas außerhalb"
                  },
                  "axt.help": "Something that is not an entry, such as a web page.",
                  "axt.help_translations": {
                    "de": "Etwas, das kein Eintrag ist, etwa eine Webseite."
                  },
                  "axt.emoji": "🌐",
                  "fields": [
                    {
                      "name": "uri",
                      "type": "string",
                      "doc": "A URI of RFC 3986 that names the thing, of any scheme, such as https: or urn:. Not empty.",
                      "axt.label": "URI",
                      "axt.label_translations": {
                        "de": "URI"
                      },
                      "axt.help": "The address of the linked thing.",
                      "axt.help_translations": {
                        "de": "Die Adresse des verknüpften Dings."
                      },
                      "axt.emoji": "🔗",
                      "axt.format": "uri"
                    },
                    {
                      "name": "text",
                      "type": "string",
                      "default": "",
                      "doc": "A text to show for the thing, such as its name. Empty when there is none.",
                      "axt.label": "Display text",
                      "axt.label_translations": {
                        "de": "Anzeigetext"
                      },
                      "axt.help": "What to show for the linked thing.",
                      "axt.help_translations": {
                        "de": "Was für das verknüpfte Ding angezeigt wird."
                      },
                      "axt.emoji": "💬"
                    }
                  ]
                }
              ],
              "doc": "What the relation points at: a record, or a thing outside AXT.",
              "axt.label": "Target",
              "axt.label_translations": {
                "de": "Ziel"
              },
              "axt.help": "What is linked.",
              "axt.help_translations": {
                "de": "Was verknüpft ist."
              },
              "axt.emoji": "🎯"
            },
            {
              "name": "note",
              "type": "string",
              "default": "",
              "doc": "Free text about the link. Empty when there is none.",
              "axt.label": "Note",
              "axt.label_translations": {
                "de": "Notiz"
              },
              "axt.help": "Something about this link.",
              "axt.help_translations": {
                "de": "Etwas zu dieser Verknüpfung."
              },
              "axt.emoji": "📝",
              "axt.multiline": true
            },
            {
              "name": "start",
              "type": [
                "null",
                {
                  "type": "record",
                  "name": "DateTime",
                  "namespace": "axt",
                  "doc": "A date and time on the wall clock, to the millisecond, either in a time zone of the IANA time zone database, with the offset from UTC and the instant as the writer's zone rules gave them, or floating, on the wall clock of wherever the user is, without zone, offset and instant. Defined in spec/time.md. Its schema never changes.",
                  "fields": [
                    {
                      "name": "year",
                      "type": "int",
                      "doc": "The year of the proleptic Gregorian calendar, 1 to 9999."
                    },
                    {
                      "name": "month",
                      "type": "int",
                      "doc": "The month, 1 (January) to 12 (December)."
                    },
                    {
                      "name": "day",
                      "type": "int",
                      "doc": "The day of the month, 1 to the number of days of that month in that year."
                    },
                    {
                      "name": "hour",
                      "type": "int",
                      "doc": "The hour on the wall clock, 0 to 23."
                    },
                    {
                      "name": "minute",
                      "type": "int",
                      "doc": "The minute, 0 to 59."
                    },
                    {
                      "name": "second",
                      "type": "int",
                      "doc": "The second, 0 to 59; a leap second is not written as 60."
                    },
                    {
                      "name": "millisecond",
                      "type": "int",
                      "doc": "The millisecond, 0 to 999."
                    },
                    {
                      "name": "zone",
                      "type": [
                        "null",
                        "string"
                      ],
                      "default": null,
                      "doc": "The name of the time zone in the IANA time zone database, such as Europe/Berlin. Null for a floating time; then offset_seconds and instant_ms are null as well."
                    },
                    {
                      "name": "offset_seconds",
                      "type": [
                        "null",
                        "int"
                      ],
                      "default": null,
                      "doc": "The offset of the wall clock from UTC, in seconds, -64800 to 64800, as the writer's rules of the zone gave it at the instant, such as 3600 for 01:00 east of UTC. Null for a floating time, and only then."
                    },
                    {
                      "name": "instant_ms",
                      "type": [
                        "null",
                        "long"
                      ],
                      "default": null,
                      "doc": "The instant, in milliseconds since 1970-01-01T00:00:00Z without leap seconds: the wall clock read as if it were UTC, minus offset_seconds. Null for a floating time, and only then."
                    }
                  ]
                }
              ],
              "default": null,
              "doc": "When the link begins, such as the day a pet came to its keeper. Null when it has no beginning or it is not known.",
              "axt.label": "From",
              "axt.label_translations": {
                "de": "Ab"
              },
              "axt.help": "When the link begins.",
              "axt.help_translations": {
                "de": "Wann die Verknüpfung beginnt."
              },
              "axt.emoji": "▶️"
            },
            {
              "name": "end",
              "type": [
                "null",
                "axt.DateTime"
              ],
              "default": null,
              "doc": "The first moment after the link, as for the end of an appointment. Null when it has no end or it is not known.",
              "axt.label": "Until",
              "axt.label_translations": {
                "de": "Bis"
              },
              "axt.help": "When the link ends.",
              "axt.help_translations": {
                "de": "Wann die Verknüpfung endet."
              },
              "axt.emoji": "⏹️"
            },
            {
              "name": "attributes",
              "type": {
                "type": "map",
                "values": "string"
              },
              "default": {},
              "doc": "Further values that the kind of the relation needs, by names its kind gives them. Empty when there are none.",
              "axt.label": "Details",
              "axt.label_translations": {
                "de": "Details"
              },
              "axt.help": "Further details of the link.",
              "axt.help_translations": {
                "de": "Weitere Angaben zur Verknüpfung."
              },
              "axt.emoji": "🗂️",
              "axt.advanced": true
            }
          ]
        }
      },
      "default": [],
      "doc": "The relations of the record to other records and to things outside AXT (spec/types.md, section 8), in the order the user gave them. Empty when it has none."
    },
    {
      "name": "extensions",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "Extension",
          "namespace": "axt",
          "doc": "An extension: one record of an app's own type that the app adds to a record of another type, such as the fields of its own that a cat-a-log adds to a Pet, held as the bytes of its single-object encoding. Defined in spec/fields.md, section 12.",
          "axt.label": "Extension",
          "axt.label_translations": {
            "de": "Erweiterung"
          },
          "axt.help": "Further fields that an app adds to this entry.",
          "axt.help_translations": {
            "de": "Weitere Felder, die eine App diesem Eintrag hinzufügt."
          },
          "axt.emoji": "🧩",
          "fields": [
            {
              "name": "name",
              "type": "string",
              "doc": "The full name of the extension's record type, such as org.example.catalog.CatExtension, which holds its major version, of at most 256 bytes; at most one extension of a name in a list.",
              "axt.label": "Extension type",
              "axt.label_translations": {
                "de": "Erweiterungstyp"
              },
              "axt.help": "The type of this extension.",
              "axt.help_translations": {
                "de": "Der Typ dieser Erweiterung."
              },
              "axt.advanced": true
            },
            {
              "name": "data",
              "type": "bytes",
              "doc": "The extension's record in single-object encoding: the marker C3 01, the fingerprint of its writer schema as 8 bytes in little-endian order, and the record's Avro binary encoding. Passed on unchanged by an app that does not know the type.",
              "axt.label": "Extension data",
              "axt.label_translations": {
                "de": "Erweiterungsdaten"
              },
              "axt.help": "The values of this extension.",
              "axt.help_translations": {
                "de": "Die Werte dieser Erweiterung."
              },
              "axt.advanced": true
            }
          ]
        }
      },
      "default": [],
      "doc": "The extensions of the record: records of the apps' own types that add fields of their own to it (spec/fields.md, section 12), at most one of each type. Empty when it has none."
    }
  ]
}
