 "$defs": {
  "limit": {
   "description": "One limit.",
   "type": "object",
   "required": [
    "value",
    "unit",
    "what",
    "section"
   ],
   "additionalProperties": false,
   "properties": {
    "value": {
     "description": "The limit, in its unit: the largest value allowed, or for a time the time it names.",
     "type": "integer",
     "minimum": 1
    },
    "unit": {
     "description": "What value counts.",
     "enum": [
      "bytes",
      "characters",
      "code points",
      "entries",
      "depth",
      "number",
      "seconds"
     ]
    },
    "what": {
     "description": "What the limit applies to.",
     "type": "string"
    },
    "section": {
     "description": "The section of the specification that sets the limit and says what happens above it.",
     "type": "string",
     "pattern": "^[a-z]+\\.md, section [0-9]+(\\.[0-9]+)*$"
    }
   }
  }
 }
